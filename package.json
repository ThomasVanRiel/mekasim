{
  "name": "mekasim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mekasim/sim-web --filter @mekasim/fit-web dev",
    "dev:sim": "pnpm --filter @mekasim/sim-web dev",
    "dev:fit": "pnpm --filter @mekasim/fit-web dev",
    "build": "pnpm --filter @mekasim/sim-web --filter @mekasim/fit-web build",
    "build:sim": "pnpm --filter @mekasim/sim-web build",
    "build:fit": "pnpm --filter @mekasim/fit-web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "solve": "node packages/core/src/cli.ts",
    "schema": "node packages/core/scripts/write-schema.ts",
    "baseline": "node packages/core/scripts/write-baseline.ts",
    "fit:study": "node packages/fit/src/cli.ts study"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2"
  }
}
